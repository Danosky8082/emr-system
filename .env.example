# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=postgresql://neondb_owner:npg_3GaVOhS4ergA@ep-calm-art-b17ec4d1.c-5.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ============================================================
# AUTH
# ============================================================
JWT_SECRET=change-me-to-a-long-random-string
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# ============================================================
# SERVER
# ============================================================
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ============================================================
# BACKUPS
# ============================================================
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# ============================================================
# OBJECT STORAGE
# ============================================================
# Use 'local' for dev (no setup), 'cloudinary' for production.
STORAGE_BACKEND=local

# Cloudinary — only needed if STORAGE_BACKEND=cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret