  status          String   @default("Ordered")
  
  result          String?
  resultDate      DateTime?
  report          String?
  imagesUrl       String?
  
  // Image Upload Fields
  images          String?
  imageCount      Int      @default(0)
  hasImages       Boolean  @default(false)
  
  radiologistId   String?
  radiologist     Staff?   @relation("PerformingRadiologist", fields: [radiologistId], references: [id])
  
  billingRecordId String?
  billingRecord   BillingRecord? @relation(fields: [billingRecordId], references: [id])
  
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  imagingResults  ImagingResult[]
}

// 34. Radiology Results
model ImagingResult {
  id              String   @id @default(cuid())
