// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. Core Patient Model
model Patient {
  id                    String   @id @default(cuid())
  hospitalId            String   @unique
  firstName             String
  lastName              String
  dateOfBirth           DateTime
  gender                String
  phone                 String?
  email                 String?  @unique
  address               String?
  emergencyContact      String?
  allergies             String?
  nextOfKinName         String?
  nextOfKinPhone        String?
  nextOfKinRelationship String?

  // Patient Category / Classification
  patientCategory   String  @default("FPP")
  insuranceProvider String?
  insuranceId       String?
  corporateCompany  String?

  // Patient Portal Fields
  password         String?   // Hashed password for patient portal
  portalAccess     Boolean   @default(false)
  lastLogin        DateTime?
  isVerified       Boolean   @default(false)
  pinCode          String?   // For quick access (optional)

  // Archive fields
  isArchived     Boolean   @default(false)
  archivedAt     DateTime?
  archivedReason String?
  archivedBy     String?
  autoArchived   Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  appointments   Appointment[]
  clinicalNotes  ClinicalNote[]
  billingRecords BillingRecord[]
  prescriptions  Prescription[]
  labOrders      LabOrder[]
  admissions     Admission[]
  historyRecords PatientHistoryRecord[]
  journeys       PatientJourney[]
  vitals         VitalSign[]
  pregnancies    Pregnancy[]

  // Patient Portal Relations
  notifications  PatientNotification[]
  messages       PatientMessage[]
  queueEntries   PatientQueue[]
  kioskSessions  KioskSession[]

  // Radiology/Imaging Relations
  imagingOrders  ImagingOrder[]

  // Transfer Relations
  patientTransfers PatientTransfer[]

  // Payment Plan Relations
  paymentPlans   PaymentPlan[]

  // NHIS Relations
  nhisAuthorizations NHISAuthorization[]
  nhisClaims         NHISClaim[]

  // ✅ NEW: Dental, Optometry, Immunization Relations
  dentalRecords    DentalRecord[]
  optometryRecords OptometryRecord[]
  immunizations    Immunization[]
}

// 2. Staff Model - COMPLETE FIXED VERSION
model Staff {
  id         String  @id @default(cuid())
  employeeId String  @unique
  username   String  @unique
  firstName  String
  lastName   String
  email      String  @unique
  role       String
  password   String
  isActive   Boolean @default(true)

  // HR DEPARTMENT & MANAGER RELATIONS
  departmentId     String?  @map("department_id")
  department       Department? @relation("StaffDepartment", fields: [departmentId], references: [id])
  managerId        String?  @map("manager_id")
  manager          Staff?   @relation("StaffManager", fields: [managerId], references: [id])
  
  // HR Fields
  dateOfBirth      DateTime?
  gender           String?
  phone            String?
  address          String?
  emergencyContact String?
  employmentType   String?
  startDate        DateTime?
  endDate          DateTime?
  salary           Float?
  bankName         String?
  bankAccount      String?
  bankBranch       String?
  taxId            String?
  nationalId       String?

  // Relations - Clinical
  appointments           Appointment[]    @relation("DoctorAppointments")
  clinicalNotes          ClinicalNote[]   @relation("AuthorNotes")
  prescriptions          Prescription[]   @relation("PrescribingStaff")
  dispensedPrescriptions Prescription[]   @relation("DispensingStaff")
  labOrders              LabOrder[]       @relation("OrderingStaff")
  performedLabOrders     LabOrder[]       @relation("PerformingStaff")
  auditLogs              AuditLog[]
  admissions             Admission[]      @relation("DoctorAdmissions")
  registeredJourneys     PatientJourney[] @relation("RegisteredJourneys")
  vitals                 VitalSign[]

  // Assignments
  clinics StaffClinic[]
  wards   StaffWard[]

  // Antenatal
  antenatalVisits AntenatalVisit[] @relation("AntenatalVisits")
  deliveries      Delivery[]       @relation("Deliveries")

  // NHIS Relations
  nhisAuthorizationsApproved NHISAuthorization[]   @relation("ApprovedByNHIS")
  nhisClaimsSubmitted        NHISClaim[]           @relation("SubmittedByNHIS")
  nhisClaimsApproved         NHISClaim[]           @relation("ApprovedByClaim")
  pharmacyStaff              PharmacyStaff[]
  pharmacyTransactions       PharmacyTransaction[]

  // Patient Portal Relations
  patientMessages            PatientMessage[]
  assignedQueueEntries       PatientQueue[]        @relation("AssignedQueue")

  // Radiology/Imaging Relations
  imagingOrdersOrdered       ImagingOrder[]        @relation("OrderingRadiologist")
  imagingOrdersPerformed     ImagingOrder[]        @relation("PerformingRadiologist")

  // Transfer Relations
  transferRequests           PatientTransfer[]     @relation("RequestedByStaff")
  transferApprovals          PatientTransfer[]     @relation("ApprovedByStaff")

  // Payment Plan Relations
  paymentProcessed           PartialPayment[]      @relation("ProcessedByStaff")

  // HR MODULE RELATIONS
  managedDepartments         Department[]          @relation("DepartmentManager")
  managedStaff               Staff[]               @relation("StaffManager")
  leaveRequests              LeaveRequest[]        @relation("LeaveRequests")
  approvedLeaves             LeaveRequest[]        @relation("LeaveApprover")
  substituteLeaves           LeaveRequest[]        @relation("LeaveSubstitute")
  attendance                 Attendance[]
  performanceReviews         PerformanceReview[]   @relation("StaffReviews")
  conductedReviews           PerformanceReview[]   @relation("Reviewer")
  staffTrainings             StaffTraining[]

  // LEAVE NOTIFICATIONS
  leaveNotifications         LeaveNotification[]   @relation("staffNotifications")

  // LEAVE ENTITLEMENT RELATIONS
  leaveEntitlements          StaffLeaveEntitlement[]
  leaveUsages                LeaveUsage[]          @relation("LeaveUsageStaff")
  approvedLeaveUsages        LeaveUsage[]          @relation("LeaveUsageApprover")

  // ✅ NEW: Dental, Optometry, Immunization Staff Relations
  dentalRecords    DentalRecord[]    @relation("DentalStaff")
  optometryRecords OptometryRecord[] @relation("OptometryStaff")

  // Timestamps
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  nhisauthorizations NHISAuthorization[]
}

// JOIN TABLES FOR STAFF ASSIGNMENTS
model StaffClinic {
  staffId  String
  clinicId String
  staff    Staff  @relation(fields: [staffId], references: [id])
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@id([staffId, clinicId])
}

model StaffWard {
  staffId String
  wardId  String
  staff   Staff  @relation(fields: [staffId], references: [id])
  ward    Ward   @relation(fields: [wardId], references: [id], onDelete: Cascade)

  @@id([staffId, wardId])
}

// 3. Appointment Model
model Appointment {
  id        String   @id @default(cuid())
  patientId String
  staffId   String
  dateTime  DateTime
  duration  Int      @default(30)
  status    String   @default("Scheduled")
  type      String   @default("Consultation")
  notes     String?
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  staff     Staff    @relation("DoctorAppointments", fields: [staffId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  queueEntries     PatientQueue[]
  reminders        AppointmentReminder[]
}

// 4. Clinical Notes (SOAP)
model ClinicalNote {
  id          String   @id @default(cuid())
  patientId   String
  authorId    String
  type        String   @default("SOAP")
  subjective  String?
  objective   String?
  assessment  String?
  plan        String?
  fullContent String?
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  author      Staff    @relation("AuthorNotes", fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 5. Prescriptions
model Prescription {
  id                 String              @id @default(cuid())
  patientId          String
  prescribingStaffId String
  dispensingStaffId  String?
  medication         String
  dosage             String
  frequency          String
  duration           String
  instructions       String?
  
  pharmacistNotes    String?
  dispensedAt        DateTime?
  rejectionReason    String?
  
  status             String              @default("Prescribed")
  
  patient            Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  prescribedBy       Staff               @relation("PrescribingStaff", fields: [prescribingStaffId], references: [id])
  dispensedBy        Staff?              @relation("DispensingStaff", fields: [dispensingStaffId], references: [id])
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  nhisauthorizations NHISAuthorization[]
  nhisclaims         NHISClaim[]
}

// 6. Lab Orders
model LabOrder {
  id              String    @id @default(cuid())
  patientId       String
  orderingStaffId String
  labStaffId      String?
  testName        String
  testType        String
  priority        String    @default("Routine")
  status          String    @default("Ordered")
  result          String?
  resultDate      DateTime?
  notes           String?
  patient         Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  orderedBy       Staff     @relation("OrderingStaff", fields: [orderingStaffId], references: [id])
  performedBy     Staff?    @relation("PerformingStaff", fields: [labStaffId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// 7. Billing Records
model BillingRecord {
  id                String          @id @default(cuid())
  patientId         String
  invoiceNumber     String          @unique
  description       String
  amount            Float
  discount          Float           @default(0)
  tax               Float           @default(0)
  totalAmount       Float
  status            String          @default("Pending")
  paymentMethod     String?
  paymentDate       DateTime?
  insuranceProvider String?
  insuranceClaimId  String?
  patient           Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  journey           PatientJourney? @relation("BillingJourney")
  
  paymentPlans      PaymentPlan[]
  imagingOrders     ImagingOrder[]
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

// 8. Pharmacy Inventory
model Medication {
  id                   String                  @id @default(cuid())
  name                 String
  genericName          String?
  category             String
  supplier             String?
  unitPrice            Float
  stockQuantity        Int
  reorderLevel         Int
  expiryDate           DateTime
  batchNumber          String?
  transactions         MedicationTransaction[]
  
  nhisPrices           NHISDrugPrice[]
  nhisFormulary        NHISDrugFormulary[]
  
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  pharmacyTransactions PharmacyTransaction[]
}

// 9. Medication Transactions
model MedicationTransaction {
  id              String     @id @default(cuid())
  medicationId    String
  transactionType String
  quantity        Int
  unitPrice       Float
  totalPrice      Float      @default(0)
  note            String?
  staffId         String?
  medication      Medication @relation(fields: [medicationId], references: [id])
  createdAt       DateTime   @default(now())
}

// 10. Audit Logs
model AuditLog {
  id        String   @id @default(cuid())
  staffId   String
  action    String
  module    String
  details   String?
  ipAddress String?
  staff     Staff    @relation(fields: [staffId], references: [id])
  createdAt DateTime @default(now())
}

// 11. WARD MODEL
model Ward {
  id               String           @id @default(cuid())
  name             String           @unique
  description      String?
  capacity         Int?
  admissions       Admission[]
  patientJourneys  PatientJourney[]
  staffAssignments StaffWard[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  queueEntries     PatientQueue[]
  fromTransfers    PatientTransfer[] @relation("FromWardTransfer")
  toTransfers      PatientTransfer[] @relation("ToWardTransfer")
}

// 12. ADMISSION MODEL
model Admission {
  id              String    @id @default(uuid())
  admissionNumber String    @unique
  patientId       String
  patient         Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  staffId         String
  staff           Staff     @relation("DoctorAdmissions", fields: [staffId], references: [id])
  wardId          String?
  ward            Ward?     @relation(fields: [wardId], references: [id])
  admissionDate   DateTime  @default(now())
  dischargeDate   DateTime?
  status          String    @default("Admitted")
  notes           String?
  
  admissionSource String   @default("CLINIC")
  referringDoctor String?
  referralHospital String?
  triageLevel     String?
  admittedBy      String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// 13. Patient History & Coding
model PatientHistoryRecord {
  id            String   @id @default(uuid())
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounterDate DateTime @default(now())
  doctorName    String
  encounterType String
  diagnosis     String
  icd10Code     String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// 14. ROI Requests
model ROIRequest {
  id            String   @id @default(uuid())
  requestorName String
  patientName   String
  requestDate   DateTime @default(now())
  requestType   String
  status        String   @default("Pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// 15. CLINIC MODEL
model Clinic {
  id               String           @id @default(cuid())
  name             String           @unique
  description      String?
  location         String?
  isActive         Boolean          @default(true)
  journeys         PatientJourney[]
  servicePrices    ServicePrice[]
  staffAssignments StaffClinic[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  queueEntries     PatientQueue[]
  fromTransfers    PatientTransfer[] @relation("FromClinicTransfer")
  toTransfers      PatientTransfer[] @relation("ToClinicTransfer")
}

// 16. PATIENT JOURNEY MODEL
model PatientJourney {
  id                  String         @id @default(cuid())
  patientId           String
  patient             Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  destinationType     String         @default("CLINIC")
  clinicId            String?
  clinic              Clinic?        @relation(fields: [clinicId], references: [id])
  wardId              String?
  ward                Ward?          @relation(fields: [wardId], references: [id])
  registeredById      String
  registeredBy        Staff          @relation("RegisteredJourneys", fields: [registeredById], references: [id])
  status              String         @default("REGISTERED")
  cardGeneratedAt     DateTime?
  sentToDestinationAt DateTime?
  completedAt         DateTime?
  archivedAt          DateTime?
  billingRecordId     String?        @unique
  billingRecord       BillingRecord? @relation("BillingJourney", fields: [billingRecordId], references: [id])
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

// 17. SERVICE PRICING CATALOG
model ServicePrice {
  id          String   @id @default(cuid())
  name        String
  description String?
  amount      Float
  clinicId    String?
  clinic      Clinic?  @relation(fields: [clinicId], references: [id])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 18. SERVICE PRICING BY CATEGORY
model ServicePricing {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String?
  category       String   @default("FPP")
  basePrice      Float    @default(0)
  nhisPrice      Float    @default(0)
  corporatePrice Float    @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// 19. VITAL SIGNS
model VitalSign {
  id                     String   @id @default(cuid())
  patientId              String
  patient                Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  nurseId                String
  nurse                  Staff    @relation(fields: [nurseId], references: [id])
  recordedAt             DateTime @default(now())
  bloodPressureSystolic  Int?
  bloodPressureDiastolic Int?
  heartRate              Int?
  temperature            Float?
  respiratoryRate        Int?
  oxygenSaturation       Int?
  weight                 Float?
  height                 Float?
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// 20. DYNAMIC ROLE PERMISSIONS
model RolePermission {
  id                    String   @id @default(cuid())
  role                  String   @unique
  dashboard             Boolean  @default(true)
  patients              Boolean  @default(false)
  staff                 Boolean  @default(false)
  appointments          Boolean  @default(false)
  prescriptions         Boolean  @default(false)
  labOrders             Boolean  @default(false)
  billing               Boolean  @default(false)
  pharmacy              Boolean  @default(false)
  pharmacyDashboard     Boolean  @default(false)
  pharmacyInventory     Boolean  @default(false)
  nhisManagement        Boolean  @default(false)
  nhisAuthorizations    Boolean  @default(false)
  pharmacyStock         Boolean  @default(false)
  pharmacyTransactions  Boolean  @default(false)
  pharmacyBranches      Boolean  @default(false)
  clinics               Boolean  @default(false)
  wards                 Boolean  @default(false)
  pricing               Boolean  @default(false)
  billingOfficer        Boolean  @default(false)
  patientIntake         Boolean  @default(false)
  admissions            Boolean  @default(false)
  patientHistory        Boolean  @default(false)
  roiRequests           Boolean  @default(false)
  nurseDashboard        Boolean  @default(false)
  doctorDashboard       Boolean  @default(false)
  antenatal             Boolean  @default(false)
  archivedPatients      Boolean  @default(false)
  archivedPatientsView  Boolean  @default(false)
  queueManagement       Boolean  @default(false)
  doctorQueue           Boolean  @default(false)
  hrDashboard           Boolean  @default(false)
  hrEmployees           Boolean  @default(false)
  hrDepartments         Boolean  @default(false)
  hrLeaves              Boolean  @default(false)
  hrAttendance          Boolean  @default(false)
  hrPerformance         Boolean  @default(false)
  hrTrainings           Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// 21. ANTENATAL / PREGNANCY MODULE
model Pregnancy {
  id                  String           @id @default(cuid())
  patientId           String
  patient             Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  expectedDelivery    DateTime
  gravida             Int?
  para                Int?
  lastMenstrualPeriod DateTime?
  estimatedDueDate    DateTime?
  riskLevel           String?
  status              String           @default("Active")
  notes               String?
  visits              AntenatalVisit[]
  delivery            Delivery?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

model AntenatalVisit {
  id               String    @id @default(cuid())
  pregnancyId      String
  pregnancy        Pregnancy @relation(fields: [pregnancyId], references: [id], onDelete: Cascade)
  visitDate        DateTime  @default(now())
  gestationalWeeks Int?
  bloodPressure    String?
  heartRate        Int?
  weight           Float?
  fundalHeight     Float?
  notes            String?
  staffId          String
  staff            Staff     @relation("AntenatalVisits", fields: [staffId], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Delivery {
  id            String    @id @default(cuid())
  pregnancyId   String    @unique
  pregnancy     Pregnancy @relation(fields: [pregnancyId], references: [id], onDelete: Cascade)
  deliveryDate  DateTime  @default(now())
  type          String
  durationHours Float?
  babyGender    String
  babyWeight    Float?
  babyApgar     Int?
  outcome       String
  notes         String?
  staffId       String
  staff         Staff     @relation("Deliveries", fields: [staffId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// 22. NHIS Drug Pricing
model NHISDrugPrice {
  id                String     @id @default(cuid())
  medicationId      String
  medication        Medication @relation(fields: [medicationId], references: [id])
  nhisCode          String
  nhisName          String?
  standardPrice     Float
  nhisPrice         Float
  patientCopay      Float
  nhisCoverage      Float
  maxQuantity       Int?
  refillLimit       Int        @default(3)
  validityPeriod    Int        @default(30)
  drugClass         String?
  requiresPriorAuth Boolean    @default(false)
  isActive          Boolean    @default(true)
  effectiveDate     DateTime   @default(now())
  expiryDate        DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([medicationId, nhisCode])
}

// 22b. NHIS Drug Formulary
model NHISDrugFormulary {
  id                    String     @id @default(cuid())
  medicationId          String
  medication            Medication @relation(fields: [medicationId], references: [id])
  
  nhisCode              String     @unique
  nhisName              String?
  formularyStatus       String     @default("Active")
  
  coverageType          String     @default("Full")
  coveragePercentage    Float      @default(90)
  patientCopayPercent   Float      @default(10)
  
  maxQuantityPerPrescription Int?
  maxRefills            Int        @default(3)
  validityPeriod        Int        @default(30)
  
  requiresPriorAuth     Boolean    @default(false)
  requiresDiagnosis     Boolean    @default(false)
  allowedDiagnosis      String?
  ageRestriction        String?
  genderRestriction     String?
  
  nhisPrice             Float
  patientPrice          Float
  standardPrice         Float
  
  effectiveDate         DateTime   @default(now())
  expiryDate            DateTime?
  isActive              Boolean    @default(true)
  
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  
  @@unique([medicationId, nhisCode])
}

// 23. NHIS Authorization
model NHISAuthorization {
  id                  String        @id @default(cuid())
  authorizationNumber String        @unique
  patientId           String
  patient             Patient       @relation(fields: [patientId], references: [id])
  prescriptionId      String?
  prescription        Prescription? @relation(fields: [prescriptionId], references: [id])
  medications         String
  totalAmount         Float
  nhisAmount          Float
  patientAmount       Float
  status              String        @default("Pending")
  requestedBy         String
  requestedByStaff    Staff         @relation(fields: [requestedBy], references: [id])
  approvedBy          String?
  approvedByStaff     Staff?        @relation("ApprovedByNHIS", fields: [approvedBy], references: [id])
  requestDate         DateTime      @default(now())
  approvalDate        DateTime?
  expiryDate          DateTime?
  denialReason        String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  nhisclaims          NHISClaim[]
}

// 24. NHIS Claim
model NHISClaim {
  id               String             @id @default(cuid())
  claimNumber      String             @unique
  patientId        String
  patient          Patient            @relation(fields: [patientId], references: [id])
  authorizationId  String?
  authorization    NHISAuthorization? @relation(fields: [authorizationId], references: [id])
  prescriptionId   String?
  prescription     Prescription?      @relation(fields: [prescriptionId], references: [id])
  totalAmount      Float
  nhisAmount       Float
  patientAmount    Float
  copayCollected   Float              @default(0)
  status           String             @default("Draft")
  submissionDate   DateTime?
  approvalDate     DateTime?
  paymentDate      DateTime?
  submittedBy      String
  submittedByStaff Staff              @relation("SubmittedByNHIS", fields: [submittedBy], references: [id])
  approvedBy       String?
  approvedByStaff  Staff?             @relation("ApprovedByClaim", fields: [approvedBy], references: [id])
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

// 25. Pharmacy Branch
model PharmacyBranch {
  id           String                @id @default(cuid())
  name         String
  code         String                @unique
  location     String?
  phone        String?
  email        String?
  isActive     Boolean               @default(true)
  staff        PharmacyStaff[]
  transactions PharmacyTransaction[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

// 26. Pharmacy Staff
model PharmacyStaff {
  id         String         @id @default(cuid())
  pharmacyId String
  pharmacy   PharmacyBranch @relation(fields: [pharmacyId], references: [id])
  staffId    String
  staff      Staff          @relation(fields: [staffId], references: [id])
  role       String
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([pharmacyId, staffId])
}

// 27. Pharmacy Transaction
model PharmacyTransaction {
  id                String         @id @default(cuid())
  transactionNumber String         @unique
  pharmacyId        String
  pharmacy          PharmacyBranch @relation(fields: [pharmacyId], references: [id])
  medicationId      String
  medication        Medication     @relation(fields: [medicationId], references: [id])
  transactionType   String
  quantity          Int
  unitPrice         Float
  totalPrice        Float
  reference         String?
  note              String?
  staffId           String
  staff             Staff          @relation(fields: [staffId], references: [id])
  createdAt         DateTime       @default(now())
}

// 28. Patient Queue / Check-in
model PatientQueue {
  id              String   @id @default(cuid())
  patientId       String
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  
  checkInTime     DateTime @default(now())
  checkInMethod   String   @default("manual_entry")
  
  status          String   @default("waiting")
  priority        String   @default("normal")
  
  appointmentId   String?
  appointment     Appointment? @relation(fields: [appointmentId], references: [id])
  
  destinationType String   @default("CLINIC")
  clinicId        String?
  clinic          Clinic?  @relation(fields: [clinicId], references: [id])
  wardId          String?
