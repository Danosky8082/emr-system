// schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENHANCED: Service Configuration
// ============================================================
model ServiceConfiguration {
  id              String   @id @default(cuid())
  serviceType     String   @unique // REGISTRATION, CARD, CONSULTATION
  name            String
  description     String?
  baseAmount      Float
  nhisAmount      Float?   // 10% for NHIS
  corporateAmount Float?   // 200% for Corporate
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Admission {
  id               String    @id @default(cuid())
  admissionNumber  String    @unique
  patientId        String
  staffId          String
  wardId           String?
  admissionDate    DateTime  @default(now())
  dischargeDate    DateTime?
  status           String    @default("Admitted")
  notes            String?
  admissionSource  String    @default("CLINIC")
  referringDoctor  String?
  referralHospital String?
  triageLevel      String?
  admittedBy       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime
  Patient          Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  Staff            Staff     @relation(fields: [staffId], references: [id])
  Ward             Ward?     @relation(fields: [wardId], references: [id])
}

model AntenatalVisit {
  id               String    @id @default(cuid())
  pregnancyId      String
  visitDate        DateTime  @default(now())
  gestationalWeeks Int?
  bloodPressure    String?
  heartRate        Int?
  weight           Float?
  fundalHeight     Float?
  notes            String?
  staffId          String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime
  Pregnancy        Pregnancy @relation(fields: [pregnancyId], references: [id], onDelete: Cascade)
  Staff            Staff     @relation(fields: [staffId], references: [id])
}

model Appointment {
  id                  String                @id @default(cuid())
  patientId           String
  staffId             String
  dateTime            DateTime
  duration            Int                   @default(30)
  status              String                @default("Scheduled")
  type                String                @default("Consultation")
  notes               String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  Patient             Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  Staff               Staff                 @relation(fields: [staffId], references: [id])
  AppointmentReminder AppointmentReminder[]
  PatientQueue        PatientQueue[]
}

model AppointmentReminder {
  id            String      @id @default(cuid())
  appointmentId String
  type          String
  sentAt        DateTime    @default(now())
  status        String
  message       String
  createdAt     DateTime    @default(now())
  Appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  staffId   String
  action    String
  module    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
  Staff     Staff    @relation(fields: [staffId], references: [id])
}

// ============================================================
// ENHANCED: BillingRecord with Itemized Billing
// ============================================================
model BillingRecord {
  id                String   @id @default(cuid())
  patientId         String
  invoiceNumber     String   @unique
  items             Json     // [{name, amount, category, status, paidAt?, serviceType?}]
  totalAmount       Float
  paidAmount        Float    @default(0)
  balance           Float
  status            String   @default("Pending") // Pending, Partial, Paid, Overdue
  description       String
  paymentMethod     String?  // Cash, Transfer, Card, Wallet
  paymentDate       DateTime?
  isWalletPayment   Boolean  @default(false)
  walletTransactionId String?
  cashAmountPaid    Float?
  walletAmountPaid  Float?
  paymentReference  String?  @unique
  receiptNumber     String?  @unique
  receiptGenerated  Boolean  @default(false)
  receiptGeneratedAt DateTime?
  processedBy       String?
  processedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime
  Patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  PatientJourney    PatientJourney?
  Staff             Staff?   @relation(fields: [processedBy], references: [id])
  WalletTransaction WalletTransaction?
  ImagingOrder      ImagingOrder[]
  PaymentPlan       PaymentPlan[]
}

model Clinic {
  id                                                   String            @id @default(cuid())
  name                                                 String            @unique
  description                                          String?
  location                                             String?
  isActive                                             Boolean           @default(true)
  createdAt                                            DateTime          @default(now())
  updatedAt                                            DateTime
  PatientJourney                                       PatientJourney[]
  PatientQueue                                         PatientQueue[]
  PatientTransfer_PatientTransfer_fromClinicIdToClinic PatientTransfer[] @relation("PatientTransfer_fromClinicIdToClinic")
  PatientTransfer_PatientTransfer_toClinicIdToClinic   PatientTransfer[] @relation("PatientTransfer_toClinicIdToClinic")
  ServicePrice                                         ServicePrice[]
  StaffClinic                                          StaffClinic[]
}

model ClinicalNote {
  id          String   @id @default(cuid())
  patientId   String
  authorId    String
  type        String   @default("SOAP")
  subjective  String?
  objective   String?
  assessment  String?
  plan        String?
  fullContent String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  Staff       Staff    @relation(fields: [authorId], references: [id])
  Patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Delivery {
  id            String    @id @default(cuid())
  pregnancyId   String    @unique
  deliveryDate  DateTime  @default(now())
  type          String
  durationHours Float?
  babyGender    String
  babyWeight    Float?
  babyApgar     Int?
  outcome       String
  notes         String?
  staffId       String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  Pregnancy     Pregnancy @relation(fields: [pregnancyId], references: [id], onDelete: Cascade)
  Staff         Staff     @relation(fields: [staffId], references: [id])
}

model ImagingOrder {
  id                                        String          @id @default(cuid())
  orderNumber                               String          @unique
  patientId                                 String
  imagingType                               String
  bodyPart                                  String
  priority                                  String          @default("Routine")
  clinicalHistory                           String?
  clinicalQuestion                          String?
  orderingStaffId                           String
  status                                    String          @default("Ordered")
  result                                    String?
  resultDate                                DateTime?
  report                                    String?
  imagesUrl                                 String?
  images                                    String?
  imageCount                                Int             @default(0)
  hasImages                                 Boolean         @default(false)
  radiologistId                             String?
  billingRecordId                           String?
  notes                                     String?
  createdAt                                 DateTime        @default(now())
  updatedAt                                 DateTime
  BillingRecord                             BillingRecord?  @relation(fields: [billingRecordId], references: [id])
  Staff_ImagingOrder_orderingStaffIdToStaff Staff           @relation("ImagingOrder_orderingStaffIdToStaff", fields: [orderingStaffId], references: [id])
  Patient                                   Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  Staff_ImagingOrder_radiologistIdToStaff   Staff?          @relation("ImagingOrder_radiologistIdToStaff", fields: [radiologistId], references: [id])
  ImagingResult                             ImagingResult[]
}

model ImagingResult {
  id              String       @id @default(cuid())
  imagingOrderId  String
  findings        String
  impression      String
  recommendations String?
  severity        String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime
  ImagingOrder    ImagingOrder @relation(fields: [imagingOrderId], references: [id], onDelete: Cascade)
}

model KioskSession {
  id           String    @id @default(cuid())
  patientId    String
  sessionToken String    @unique
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  status       String    @default("active")
  deviceInfo   String?
  ipAddress    String?
  Patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model LabOrder {
  id                String   @id @default(cuid())
  patientId         String
  orderingStaffId   String
  labStaffId        String?
  testName          String
  testType          String
  priority          String   @default("Routine")
  status            String   @default("Ordered")
  result            String?
  resultDate        DateTime?
  notes             String?
  
  // ✅ ADD THESE VALIDATION FIELDS
  validated         Boolean  @default(false)
  validatedBy       String?
  validatedAt       DateTime?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  Staff_LabOrder_labStaffIdToStaff      Staff?  @relation("LabOrder_labStaffIdToStaff", fields: [labStaffId], references: [id])
  Staff_LabOrder_orderingStaffIdToStaff Staff   @relation("LabOrder_orderingStaffIdToStaff", fields: [orderingStaffId], references: [id])
  Patient           Patient             @relation(fields: [patientId], references: [id])
}

model Medication {
  id                    String                  @id @default(cuid())
  name                  String
  genericName           String?
  category              String
  supplier              String?
  unitPrice             Float
  stockQuantity         Int
  reorderLevel          Int
  expiryDate            DateTime
  batchNumber           String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  MedicationTransaction MedicationTransaction[]
  NHISDrugFormulary     NHISDrugFormulary[]
  NHISDrugPrice         NHISDrugPrice[]
  PharmacyTransaction   PharmacyTransaction[]
}

model MedicationTransaction {
  id              String     @id @default(cuid())
  medicationId    String
  transactionType String
  quantity        Int
  unitPrice       Float
  totalPrice      Float      @default(0)
  note            String?
  staffId         String?
  createdAt       DateTime   @default(now())
  Medication      Medication @relation(fields: [medicationId], references: [id])
}

model NHISAuthorization {
  id                                         String        @id @default(cuid())
  authorizationNumber                        String        @unique
  patientId                                  String
  prescriptionId                             String?
  medications                                String
  totalAmount                                Float
  nhisAmount                                 Float
  patientAmount                              Float
  status                                     String        @default("Pending")
  requestedBy                                String
  approvedBy                                 String?
  requestDate                                DateTime      @default(now())
  approvalDate                               DateTime?
  expiryDate                                 DateTime?
  denialReason                               String?
  createdAt                                  DateTime      @default(now())
  updatedAt                                  DateTime
  Staff_NHISAuthorization_approvedByToStaff  Staff?        @relation("NHISAuthorization_approvedByToStaff", fields: [approvedBy], references: [id])
  Patient                                    Patient       @relation(fields: [patientId], references: [id])
  Prescription                               Prescription? @relation(fields: [prescriptionId], references: [id])
  Staff_NHISAuthorization_requestedByToStaff Staff         @relation("NHISAuthorization_requestedByToStaff", fields: [requestedBy], references: [id])
  NHISClaim                                  NHISClaim[]
}

model NHISClaim {
  id                                 String             @id @default(cuid())
  claimNumber                        String             @unique
  patientId                          String
  authorizationId                    String?
  prescriptionId                     String?
  totalAmount                        Float
  nhisAmount                         Float
  patientAmount                      Float
  copayCollected                     Float              @default(0)
  status                             String             @default("Draft")
  submissionDate                     DateTime?
  approvalDate                       DateTime?
  paymentDate                        DateTime?
  submittedBy                        String
  approvedBy                         String?
  notes                              String?
  createdAt                          DateTime           @default(now())
  updatedAt                          DateTime
  Staff_NHISClaim_approvedByToStaff  Staff?             @relation("NHISClaim_approvedByToStaff", fields: [approvedBy], references: [id])
  NHISAuthorization                  NHISAuthorization? @relation(fields: [authorizationId], references: [id])
  Patient                            Patient            @relation(fields: [patientId], references: [id])
  Prescription                       Prescription?      @relation(fields: [prescriptionId], references: [id])
  Staff_NHISClaim_submittedByToStaff Staff              @relation("NHISClaim_submittedByToStaff", fields: [submittedBy], references: [id])
}

model NHISDrugFormulary {
  id                         String     @id @default(cuid())
  medicationId               String
  nhisCode                   String     @unique
  nhisName                   String?
  formularyStatus            String     @default("Active")
  coverageType               String     @default("Full")
  coveragePercentage         Float      @default(90)
  patientCopayPercent        Float      @default(10)
  maxQuantityPerPrescription Int?
  maxRefills                 Int        @default(3)
  validityPeriod             Int        @default(30)
  requiresPriorAuth          Boolean    @default(false)
  requiresDiagnosis          Boolean    @default(false)
  allowedDiagnosis           String?
  ageRestriction             String?
  genderRestriction          String?
  nhisPrice                  Float
  patientPrice               Float
  standardPrice              Float
  effectiveDate              DateTime   @default(now())
  expiryDate                 DateTime?
  isActive                   Boolean    @default(true)
  createdAt                  DateTime   @default(now())
  updatedAt                  DateTime
  Medication                 Medication @relation(fields: [medicationId], references: [id])

  @@unique([medicationId, nhisCode])
}

model NHISDrugPrice {
  id                String     @id @default(cuid())
  medicationId      String
  nhisCode          String
  nhisName          String?
  standardPrice     Float
  nhisPrice         Float
  patientCopay      Float
  nhisCoverage      Float
  maxQuantity       Int?
  refillLimit       Int        @default(3)
  validityPeriod    Int        @default(30)
  drugClass         String?
  requiresPriorAuth Boolean    @default(false)
  isActive          Boolean    @default(true)
  effectiveDate     DateTime   @default(now())
  expiryDate        DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime
  Medication        Medication @relation(fields: [medicationId], references: [id])

  @@unique([medicationId, nhisCode])
}

model PartialPayment {
  id            String      @id @default(cuid())
  paymentPlanId String
  amount        Float
  paymentMethod String
  reference     String?
  notes         String?
  processedBy   String
  createdAt     DateTime    @default(now())
  PaymentPlan   PaymentPlan @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)
  Staff         Staff       @relation(fields: [processedBy], references: [id])
}

model Patient {
  id                    String                  @id @default(cuid())
  hospitalId            String                  @unique
  firstName             String
  lastName              String
  dateOfBirth           DateTime
  gender                String
  phone                 String?
  email                 String?                 @unique
  address               String?
  emergencyContact      String?
  allergies             String?
  nextOfKinName         String?
  nextOfKinPhone        String?
  nextOfKinRelationship String?
  patientCategory       String                  @default("FPP")
  insuranceProvider     String?
  insuranceId           String?
  corporateCompany      String?
  password              String?
  portalAccess          Boolean                 @default(false)
  lastLogin             DateTime?
  isVerified            Boolean                 @default(false)
  pinCode               String?
  mustChangePassword    Boolean                 @default(false)
  pinAttempts           Int                     @default(0)
  passwordAttempts      Int                     @default(0)
  lockedUntil           DateTime?
  lastPinChange         DateTime?
  lastPasswordChange    DateTime?
  isArchived            Boolean                 @default(false)
  archivedAt            DateTime?
  archivedReason        String?
  archivedBy            String?
  autoArchived          Boolean                 @default(false)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt 
  walletId              String?                 @unique
  Admission             Admission[]
  Appointment           Appointment[]
  BillingRecord         BillingRecord[]
  ClinicalNote          ClinicalNote[]
  ImagingOrder          ImagingOrder[]
  KioskSession          KioskSession[]
  LabOrder              LabOrder[]
  NHISAuthorization     NHISAuthorization[]
  NHISClaim             NHISClaim[]
  PatientHistoryRecord  PatientHistoryRecord[]
  PatientJourney        PatientJourney[]
  PatientMessage        PatientMessage[]
  PatientQueue          PatientQueue[]
  PatientTransfer       PatientTransfer[]
  PatientWallet         PatientWallet?
  PaymentPlan           PaymentPlan[]
  Pregnancy             Pregnancy[]
  Prescription          Prescription[]
  VitalSign             VitalSign[]
  dental_records        dental_records[]
  immunizations         immunizations[]
  optometry_records     optometry_records[]
  patient_notifications patient_notifications[]
}

model PatientHistoryRecord {
  id            String   @id @default(cuid())
  patientId     String
  encounterDate DateTime @default(now())
  doctorName    String
  encounterType String
  diagnosis     String
  icd10Code     String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  Patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

// ============================================================
// ENHANCED: PatientJourney with Fee Tracking
// ============================================================
model PatientJourney {
  id                          String         @id @default(cuid())
  patientId                   String
  destinationType             String         @default("CLINIC")
  clinicId                    String?
  wardId                      String?
  registeredById              String
  status                      String         @default("REGISTERED")
  cardGeneratedAt             DateTime?
  sentToDestinationAt         DateTime?
  completedAt                 DateTime?
  archivedAt                  DateTime?
  billingRecordId             String?        @unique
  
  // Auto-billing flags
  registrationFeeBilled       Boolean        @default(false)
  registrationFeePaid         Boolean        @default(false)
  cardFeeBilled               Boolean        @default(false)
  cardFeePaid                 Boolean        @default(false)
  consultationFeeBilled       Boolean        @default(false)
  consultationFeePaid         Boolean        @default(false)
  
  registrationFeeRecordId     String?
  cardFeeRecordId             String?
  consultationFeeRecordId     String?
  
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime
  BillingRecord               BillingRecord? @relation(fields: [billingRecordId], references: [id])
  Clinic                      Clinic?        @relation(fields: [clinicId], references: [id])
  Patient                     Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  Staff                       Staff          @relation(fields: [registeredById], references: [id])
  Ward                        Ward?          @relation(fields: [wardId], references: [id])
}

model PatientMessage {
  id            String   @id @default(cuid())
  patientId     String
  staffId       String
  subject       String
  message       String
  isRead        Boolean  @default(false)
  isFromPatient Boolean  @default(true)
  createdAt     DateTime @default(now())
  Patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  Staff         Staff    @relation(fields: [staffId], references: [id])
}

model PatientQueue {
  id              String       @id @default(cuid())
  patientId       String
  checkInTime     DateTime     @default(now())
  checkInMethod   String       @default("manual_entry")
  status          String       @default("waiting")
  priority        String       @default("normal")
  appointmentId   String?
  destinationType String       @default("CLINIC")
  clinicId        String?
  wardId          String?
  assignedTo      String?
  calledTime      DateTime?
  startTime       DateTime?
  endTime         DateTime?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime
  Appointment     Appointment? @relation(fields: [appointmentId], references: [id])
  Staff           Staff?       @relation(fields: [assignedTo], references: [id])
  Clinic          Clinic?      @relation(fields: [clinicId], references: [id])
  Patient         Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  Ward            Ward?        @relation(fields: [wardId], references: [id])
}

model PatientTransfer {
  id                                          String    @id @default(cuid())
  transferNumber                              String    @unique
  patientId                                   String
  fromLocationType                            String
  fromClinicId                                String?
  fromWardId                                  String?
  toLocationType                              String
  toClinicId                                  String?
  toWardId                                    String?
  reason                                      String
  priority                                    String    @default("Normal")
  transportType                               String?
  requestedBy                                 String
  approvedBy                                  String?
  status                                      String    @default("Pending")
  requestedAt                                 DateTime  @default(now())
  approvedAt                                  DateTime?
  departedAt                                  DateTime?
  arrivedAt                                   DateTime?
  notes                                       String?
  createdAt                                   DateTime  @default(now())
  updatedAt                                   DateTime
  Staff_PatientTransfer_approvedByToStaff     Staff?    @relation("PatientTransfer_approvedByToStaff", fields: [approvedBy], references: [id])
  Clinic_PatientTransfer_fromClinicIdToClinic Clinic?   @relation("PatientTransfer_fromClinicIdToClinic", fields: [fromClinicId], references: [id])
  Ward_PatientTransfer_fromWardIdToWard       Ward?     @relation("PatientTransfer_fromWardIdToWard", fields: [fromWardId], references: [id])
  Patient                                     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  Staff_PatientTransfer_requestedByToStaff    Staff     @relation("PatientTransfer_requestedByToStaff", fields: [requestedBy], references: [id])
  Clinic_PatientTransfer_toClinicIdToClinic   Clinic?   @relation("PatientTransfer_toClinicIdToClinic", fields: [toClinicId], references: [id])
  Ward_PatientTransfer_toWardIdToWard         Ward?     @relation("PatientTransfer_toWardIdToWard", fields: [toWardId], references: [id])
}

model PatientWallet {
  id                String              @id @default(cuid())
  patientId         String              @unique
  balance           Float               @default(0)
  currency          String              @default("NGN")
  status            String              @default("Active")
  lastTransactionAt DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  Patient           Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  WalletTransaction WalletTransaction[]
}

model PaymentPlan {
  id                String           @id @default(cuid())
  patientId         String
  billingRecordId   String
  totalAmount       Float
  paidAmount        Float            @default(0)
  balance           Float
  status            String           @default("Active")
  installments      Int              @default(1)
  installmentAmount Float
  frequency         String
  startDate         DateTime         @default(now())
  endDate           DateTime?
  nextPaymentDate   DateTime?
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime
  PartialPayment    PartialPayment[]
  BillingRecord     BillingRecord    @relation(fields: [billingRecordId], references: [id], onDelete: Cascade)
  Patient           Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model PharmacyBranch {
  id                  String                @id @default(cuid())
  name                String
  code                String                @unique
  location            String?
  phone               String?
  email               String?
  isActive            Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  PharmacyStaff       PharmacyStaff[]
  PharmacyTransaction PharmacyTransaction[]
}

model PharmacyStaff {
  id             String         @id @default(cuid())
  pharmacyId     String
  staffId        String
  role           String
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime
  PharmacyBranch PharmacyBranch @relation(fields: [pharmacyId], references: [id])
  Staff          Staff          @relation(fields: [staffId], references: [id])

  @@unique([pharmacyId, staffId])
}

model PharmacyTransaction {
  id                String         @id @default(cuid())
  transactionNumber String         @unique
  pharmacyId        String
  medicationId      String
  transactionType   String
  quantity          Int
  unitPrice         Float
  totalPrice        Float
  reference         String?
  note              String?
  staffId           String
  createdAt         DateTime       @default(now())
  Medication        Medication     @relation(fields: [medicationId], references: [id])
  PharmacyBranch    PharmacyBranch @relation(fields: [pharmacyId], references: [id])
  Staff             Staff          @relation(fields: [staffId], references: [id])
}

model Pregnancy {
  id                  String           @id @default(cuid())
  patientId           String
  expectedDelivery    DateTime
  gravida             Int?
  para                Int?
  lastMenstrualPeriod DateTime?
  estimatedDueDate    DateTime?
  riskLevel           String?
  status              String           @default("Active")
  notes               String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime
  AntenatalVisit      AntenatalVisit[]
  Delivery            Delivery?
  Patient             Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Prescription {
  id                                           String              @id @default(cuid())
  patientId                                    String
  prescribingStaffId                           String
  dispensingStaffId                            String?
  medication                                   String
  dosage                                       String
  frequency                                    String
  duration                                     String
  instructions                                 String?
  pharmacistNotes                              String?
  dispensedAt                                  DateTime?
  rejectionReason                              String?
  status                                       String              @default("Prescribed")
  createdAt                                    DateTime            @default(now())
  updatedAt                                    DateTime
  NHISAuthorization                            NHISAuthorization[]
  NHISClaim                                    NHISClaim[]
  Staff_Prescription_dispensingStaffIdToStaff  Staff?              @relation("Prescription_dispensingStaffIdToStaff", fields: [dispensingStaffId], references: [id])
  Patient                                      Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  Staff_Prescription_prescribingStaffIdToStaff Staff               @relation("Prescription_prescribingStaffIdToStaff", fields: [prescribingStaffId], references: [id])
}

model ROIRequest {
  id            String   @id @default(cuid())
  requestorName String
  patientName   String
  requestDate   DateTime @default(now())
  requestType   String
  status        String   @default("Pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime
}

model RolePermission {
  id                   String   @id @default(cuid())
  role                 String   @unique
  dashboard            Boolean  @default(true)
  patients             Boolean  @default(false)
  staff                Boolean  @default(false)
  appointments         Boolean  @default(false)
  prescriptions        Boolean  @default(false)
  labOrders            Boolean  @default(false)
  billing              Boolean  @default(false)
  pharmacy             Boolean  @default(false)
