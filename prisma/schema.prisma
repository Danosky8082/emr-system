generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Hospital {
  id                    String                     @id @default(cuid())
  name                  String
  slug                  String                     @unique
  code                  String                     @unique
  email                 String?
  phone                 String?
  address               String?
  city                  String?
  state                 String?
  country               String                     @default("Nigeria")
  logoUrl               String?
  primaryColor          String                     @default("#0f3460")
  secondaryColor        String                     @default("#1a4a7a")
  plan                  String                     @default("trial")
  status                String                     @default("active")
  trialEndsAt           DateTime?
  subscriptionEndsAt    DateTime?
  maxStaff              Int                        @default(50)
  maxPatients           Int                        @default(1000)
  isActive              Boolean                    @default(true)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  Admission             Admission[]
  AntenatalVisit        AntenatalVisit[]
  Appointment           Appointment[]
  AppointmentReminder   AppointmentReminder[]
  AuditLog              AuditLog[]
  BillingRecord         BillingRecord[]
  Clinic                Clinic[]
  ClinicalNote          ClinicalNote[]
  Delivery              Delivery[]
  Department            Department[]
  Settings              HospitalSettings?
  ImagingOrder          ImagingOrder[]
  ImagingResult         ImagingResult[]
  KioskSession          KioskSession[]
  LabOrder              LabOrder[]
  Medication            Medication[]
  MedicationTransaction MedicationTransaction[]
  NHISAuthorization     NHISAuthorization[]
  NHISClaim             NHISClaim[]
  NHISDrugFormulary     NHISDrugFormulary[]
  NHISDrugPrice         NHISDrugPrice[]
  PartialPayment        PartialPayment[]
  Patient               Patient[]
  PatientHistoryRecord  PatientHistoryRecord[]
  PatientJourney        PatientJourney[]
  PatientMessage        PatientMessage[]
  PatientQueue          PatientQueue[]
  PatientTransfer       PatientTransfer[]
  PatientWallet         PatientWallet[]
  PaymentPlan           PaymentPlan[]
  PharmacyBranch        PharmacyBranch[]
  PharmacyStaff         PharmacyStaff[]
  PharmacyTransaction   PharmacyTransaction[]
  Pregnancy             Pregnancy[]
  Prescription          Prescription[]
  ROIRequest            ROIRequest[]
  RolePermission        RolePermission[]
  ServiceConfiguration  ServiceConfiguration[]
  ServicePrice          ServicePrice[]
  ServicePricing        ServicePricing[]
  Staff                 Staff[]
  staffClinics          StaffClinic[]
  staffWards            StaffWard[]
  VitalSign             VitalSign[]
  WalletTransaction     WalletTransaction[]
  Ward                  Ward[]
  Attendance            attendance[]
  DentalRecord          dental_records[]
  Immunization          immunizations[]
  LeaveNotification     leave_notifications[]
  LeavePolicy           leave_policies[]
  LeaveRequest          leave_requests[]
  LeaveUsage            leave_usages[]
  OptometryRecord       optometry_records[]
  PatientNotification   patient_notifications[]
  PerformanceReview     performance_reviews[]
  StaffLeaveEntitlement staff_leave_entitlements[]
  StaffTraining         staff_trainings[]
  Training              trainings[]
}

model HospitalSettings {
  id                  String   @id @default(cuid())
  tenantId            String   @unique
  hospitalId          String   @unique
  registrationFee     Float    @default(2000)
  cardFee             Float    @default(1000)
  consultationFee     Float    @default(5000)
  nhisMultiplier      Float    @default(0.1)
  retainerMultiplier  Float    @default(2.0)
  autoArchiveHours    Int      @default(24)
  appointmentDuration Int      @default(30)
  enablePatientPortal Boolean  @default(true)
  enableKioskMode     Boolean  @default(true)
  smsEnabled          Boolean  @default(false)
  emailEnabled        Boolean  @default(false)
  smsSenderId         String?
  emailSenderName     String?
  currency            String   @default("NGN")
  currencySymbol      String   @default("₦")
  timezone            String   @default("Africa/Lagos")
  dateFormat          String   @default("DD/MM/YYYY")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  Hospital            Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
}

model ServiceConfiguration {
  id              String   @id @default(cuid())
  serviceType     String
  name            String
  description     String?
  baseAmount      Float
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  corporateAmount Float?
  nhisAmount      Float?
  tenantId        String
  Hospital        Hospital @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, serviceType])
  @@index([tenantId])
}

model Admission {
  id               String    @id @default(cuid())
  admissionNumber  String
  patientId        String
  staffId          String
  wardId           String?
  admissionDate    DateTime  @default(now())
  dischargeDate    DateTime?
  status           String    @default("Admitted")
  notes            String?
  admissionSource  String    @default("CLINIC")
  referringDoctor  String?
  referralHospital String?
  triageLevel      String?
  admittedBy       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tenantId         String
  Patient          Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  Staff            Staff     @relation(fields: [staffId], references: [id])
  Hospital         Hospital  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  Ward             Ward?     @relation(fields: [wardId], references: [id])

  @@unique([tenantId, admissionNumber])
  @@index([tenantId])
}

model AntenatalVisit {
  id               String    @id @default(cuid())
  pregnancyId      String
  visitDate        DateTime  @default(now())
  gestationalWeeks Int?
  bloodPressure    String?
  heartRate        Int?
  weight           Float?
  fundalHeight     Float?
  notes            String?
  staffId          String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tenantId         String
  Pregnancy        Pregnancy @relation(fields: [pregnancyId], references: [id], onDelete: Cascade)
  Staff            Staff     @relation(fields: [staffId], references: [id])
  Hospital         Hospital  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Appointment {
  id                  String                @id @default(cuid())
  patientId           String
  staffId             String
  dateTime            DateTime
  duration            Int                   @default(30)
  status              String                @default("Scheduled")
  type                String                @default("Consultation")
  notes               String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  tenantId            String
  Patient             Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  Staff               Staff                 @relation(fields: [staffId], references: [id])
  Hospital            Hospital              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  AppointmentReminder AppointmentReminder[]
  PatientQueue        PatientQueue[]

  @@index([tenantId])
  @@index([tenantId, status])
}

model AppointmentReminder {
  id            String      @id @default(cuid())
  appointmentId String
  type          String
  sentAt        DateTime    @default(now())
  status        String
  message       String
  createdAt     DateTime    @default(now())
  tenantId      String
  Appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  Hospital      Hospital    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model AuditLog {
  id        String   @id @default(cuid())
  staffId   String
  action    String
  module    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
  tenantId  String
  Staff     Staff    @relation(fields: [staffId], references: [id])
  Hospital  Hospital @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, action])
}

model BillingRecord {
  id                  String             @id @default(cuid())
  patientId           String
  invoiceNumber       String
  description         String
  totalAmount         Float
  status              String             @default("Pending")
  paymentMethod       String?
  paymentDate         DateTime?
  walletTransactionId String?
  isWalletPayment     Boolean            @default(false)
  walletAmountPaid    Float?
  cashAmountPaid      Float?
  paymentReference    String?
  processedAt         DateTime?
  processedBy         String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  balance             Float
  items               Json
  paidAmount          Float              @default(0)
  receiptGenerated    Boolean            @default(false)
  receiptGeneratedAt  DateTime?
  receiptNumber       String?
  tenantId            String
  Patient             Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  Staff               Staff?             @relation(fields: [processedBy], references: [id])
  Hospital            Hospital           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ImagingOrder        ImagingOrder[]
  PatientJourney      PatientJourney?
  PaymentPlan         PaymentPlan[]
  WalletTransaction   WalletTransaction?

  @@unique([tenantId, invoiceNumber])
  @@unique([tenantId, paymentReference])
  @@unique([tenantId, receiptNumber])
  @@index([tenantId])
  @@index([tenantId, status])
}

model Clinic {
  id                                                   String            @id @default(cuid())
  name                                                 String
  description                                          String?
  location                                             String?
  isActive                                             Boolean           @default(true)
  createdAt                                            DateTime          @default(now())
  updatedAt                                            DateTime          @updatedAt
  tenantId                                             String
  Hospital                                             Hospital          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  PatientJourney                                       PatientJourney[]
  PatientQueue                                         PatientQueue[]
  PatientTransfer_PatientTransfer_fromClinicIdToClinic PatientTransfer[] @relation("PatientTransfer_fromClinicIdToClinic")
  PatientTransfer_PatientTransfer_toClinicIdToClinic   PatientTransfer[] @relation("PatientTransfer_toClinicIdToClinic")
  ServicePrice                                         ServicePrice[]
  StaffClinic                                          StaffClinic[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model ClinicalNote {
  id          String   @id @default(cuid())
  patientId   String
  authorId    String
  type        String   @default("SOAP")
  subjective  String?
  objective   String?
  assessment  String?
  plan        String?
  fullContent String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenantId    String
  Staff       Staff    @relation(fields: [authorId], references: [id])
  Patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  Hospital    Hospital @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Delivery {
  id                    String    @id @default(cuid())
  pregnancyId           String    @unique
  deliveryDate          DateTime  @default(now())
  type                  String
  durationHours         Float?
  babyGender            String
  babyWeight            Float?
  outcome               String
  notes                 String?
  staffId               String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  babyApgar10min        Int?
  babyApgar1min         Int?
  babyApgar5min         Int?
  babyHeadCircumference Float?
  babyLength            Float?
  babyNotes             String?
  complications         String?
  estimatedBloodLoss    Float?
  maternalCondition     String?
  perinealCondition     String?
  placentaDelivery      String?
  tenantId              String
  Pregnancy             Pregnancy @relation(fields: [pregnancyId], references: [id], onDelete: Cascade)
  Staff                 Staff     @relation(fields: [staffId], references: [id])
  Hospital              Hospital  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model ImagingOrder {
  id                                        String          @id @default(cuid())
  orderNumber                               String
  patientId                                 String
  imagingType                               String
  bodyPart                                  String
  priority                                  String          @default("Routine")
  clinicalHistory                           String?
  clinicalQuestion                          String?
  orderingStaffId                           String
  status                                    String          @default("Ordered")
  result                                    String?
  resultDate                                DateTime?
  report                                    String?
  imagesUrl                                 String?
  images                                    String?
  imageCount                                Int             @default(0)
  hasImages                                 Boolean         @default(false)
  radiologistId                             String?
  billingRecordId                           String?
  notes                                     String?
  createdAt                                 DateTime        @default(now())
  updatedAt                                 DateTime        @updatedAt
  tenantId                                  String
  BillingRecord                             BillingRecord?  @relation(fields: [billingRecordId], references: [id])
  Staff_ImagingOrder_orderingStaffIdToStaff Staff           @relation("ImagingOrder_orderingStaffIdToStaff", fields: [orderingStaffId], references: [id])
  Patient                                   Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  Staff_ImagingOrder_radiologistIdToStaff   Staff?          @relation("ImagingOrder_radiologistIdToStaff", fields: [radiologistId], references: [id])
  Hospital                                  Hospital        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ImagingResult                             ImagingResult[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, patientId])
}

model ImagingResult {
  id              String       @id @default(cuid())
  imagingOrderId  String
  findings        String
  impression      String
  recommendations String?
  severity        String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  tenantId        String
  ImagingOrder    ImagingOrder @relation(fields: [imagingOrderId], references: [id], onDelete: Cascade)
  Hospital        Hospital     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model KioskSession {
  id           String    @id @default(cuid())
  patientId    String
  sessionToken String    @unique
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  status       String    @default("active")
  deviceInfo   String?
  ipAddress    String?
  tenantId     String
  Patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  Hospital     Hospital  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model LabOrder {
  id                                    String    @id @default(cuid())
  patientId                             String
  orderingStaffId                       String
  labStaffId                            String?
  testName                              String
  testType                              String
  priority                              String    @default("Routine")
  status                                String    @default("Ordered")
  result                                String?
  resultDate                            DateTime?
  notes                                 String?
  createdAt                             DateTime  @default(now())
  updatedAt                             DateTime  @updatedAt
  validated                             Boolean   @default(false)
  validatedAt                           DateTime?
  validatedBy                           String?
  tenantId                              String
  Staff_LabOrder_labStaffIdToStaff      Staff?    @relation("LabOrder_labStaffIdToStaff", fields: [labStaffId], references: [id])
  Staff_LabOrder_orderingStaffIdToStaff Staff     @relation("LabOrder_orderingStaffIdToStaff", fields: [orderingStaffId], references: [id])
  Patient                               Patient   @relation(fields: [patientId], references: [id])
  Hospital                              Hospital  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
}

model Medication {
  id                    String                  @id @default(cuid())
  name                  String
  genericName           String?
  category              String
  supplier              String?
  unitPrice             Float
  stockQuantity         Int
  reorderLevel          Int
  expiryDate            DateTime
  batchNumber           String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  tenantId              String
  Hospital              Hospital                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  MedicationTransaction MedicationTransaction[]
  NHISDrugFormulary     NHISDrugFormulary[]
  NHISDrugPrice         NHISDrugPrice[]
  PharmacyTransaction   PharmacyTransaction[]

  @@index([tenantId])
  @@index([tenantId, name])
}

model MedicationTransaction {
  id              String     @id @default(cuid())
  medicationId    String
  transactionType String
  quantity        Int
  unitPrice       Float
  totalPrice      Float      @default(0)
  note            String?
  staffId         String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  reference       String?
  patientId       String?
  tenantId        String
  Medication      Medication @relation(fields: [medicationId], references: [id])
  Patient         Patient?   @relation(fields: [patientId], references: [id])
  Hospital        Hospital   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model NHISAuthorization {
  id                                         String        @id @default(cuid())
  authorizationNumber                        String
  patientId                                  String
  prescriptionId                             String?
  medications                                String
  totalAmount                                Float
  nhisAmount                                 Float
  patientAmount                              Float
  status                                     String        @default("Pending")
  requestedBy                                String
  approvedBy                                 String?
  requestDate                                DateTime      @default(now())
  approvalDate                               DateTime?
  expiryDate                                 DateTime?
  denialReason                               String?
  createdAt                                  DateTime      @default(now())
  updatedAt                                  DateTime      @updatedAt
  tenantId                                   String
  Staff_NHISAuthorization_approvedByToStaff  Staff?        @relation("NHISAuthorization_approvedByToStaff", fields: [approvedBy], references: [id])
  Patient                                    Patient       @relation(fields: [patientId], references: [id])
  Prescription                               Prescription? @relation(fields: [prescriptionId], references: [id])
  Staff_NHISAuthorization_requestedByToStaff Staff         @relation("NHISAuthorization_requestedByToStaff", fields: [requestedBy], references: [id])
  Hospital                                   Hospital      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  NHISClaim                                  NHISClaim[]

  @@unique([tenantId, authorizationNumber])
  @@index([tenantId])
}

model NHISClaim {
  id                                 String             @id @default(cuid())
  claimNumber                        String
  patientId                          String
  authorizationId                    String?
  prescriptionId                     String?
  totalAmount                        Float
  nhisAmount                         Float
  patientAmount                      Float
  copayCollected                     Float              @default(0)
  status                             String             @default("Draft")
  submissionDate                     DateTime?
  approvalDate                       DateTime?
  paymentDate                        DateTime?
  submittedBy                        String
  approvedBy                         String?
  notes                              String?
  createdAt                          DateTime           @default(now())
  updatedAt                          DateTime           @updatedAt
  tenantId                           String
  Staff_NHISClaim_approvedByToStaff  Staff?             @relation("NHISClaim_approvedByToStaff", fields: [approvedBy], references: [id])
  NHISAuthorization                  NHISAuthorization? @relation(fields: [authorizationId], references: [id])
  Patient                            Patient            @relation(fields: [patientId], references: [id])
  Prescription                       Prescription?      @relation(fields: [prescriptionId], references: [id])
  Staff_NHISClaim_submittedByToStaff Staff              @relation("NHISClaim_submittedByToStaff", fields: [submittedBy], references: [id])
  Hospital                           Hospital           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, claimNumber])
  @@index([tenantId])
}

model NHISDrugFormulary {
  id                         String     @id @default(cuid())
  medicationId               String
  nhisCode                   String
  nhisName                   String?
  formularyStatus            String     @default("Active")
  coverageType               String     @default("Full")
  coveragePercentage         Float      @default(90)
  patientCopayPercent        Float      @default(10)
  maxQuantityPerPrescription Int?
  maxRefills                 Int        @default(3)
  validityPeriod             Int        @default(30)
  requiresPriorAuth          Boolean    @default(false)
  requiresDiagnosis          Boolean    @default(false)
  allowedDiagnosis           String?
  ageRestriction             String?
  genderRestriction          String?
  nhisPrice                  Float
  patientPrice               Float
  standardPrice              Float
  effectiveDate              DateTime   @default(now())
  expiryDate                 DateTime?
  isActive                   Boolean    @default(true)
  createdAt                  DateTime   @default(now())
  updatedAt                  DateTime   @updatedAt
  tenantId                   String
  Medication                 Medication @relation(fields: [medicationId], references: [id])
  Hospital                   Hospital   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, nhisCode])
  @@unique([tenantId, medicationId, nhisCode])
  @@index([tenantId])
}

model NHISDrugPrice {
  id                String     @id @default(cuid())
  medicationId      String
  nhisCode          String
  nhisName          String?
  standardPrice     Float
  nhisPrice         Float
  patientCopay      Float
  nhisCoverage      Float
  maxQuantity       Int?
  refillLimit       Int        @default(3)
  validityPeriod    Int        @default(30)
  drugClass         String?
  requiresPriorAuth Boolean    @default(false)
  isActive          Boolean    @default(true)
  effectiveDate     DateTime   @default(now())
  expiryDate        DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  tenantId          String
  Medication        Medication @relation(fields: [medicationId], references: [id])
  Hospital          Hospital   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, medicationId, nhisCode])
  @@index([tenantId])
}

model PartialPayment {
  id            String      @id @default(cuid())
  paymentPlanId String
  amount        Float
  paymentMethod String
  reference     String?
  notes         String?
  processedBy   String
  createdAt     DateTime    @default(now())
  tenantId      String
  PaymentPlan   PaymentPlan @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)
  Staff         Staff       @relation(fields: [processedBy], references: [id])
  Hospital      Hospital    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Patient {
  id                    String                  @id @default(cuid())
  hospitalId            String
  firstName             String
  lastName              String
  dateOfBirth           DateTime
  gender                String
  phone                 String?
  email                 String?
  address               String?
  emergencyContact      String?
  allergies             String?
  nextOfKinName         String?
  nextOfKinPhone        String?
  nextOfKinRelationship String?
  patientCategory       String                  @default("FPP")
  insuranceProvider     String?
  insuranceId           String?
  corporateCompany      String?
  password              String?
  portalAccess          Boolean                 @default(false)
  lastLogin             DateTime?
  isVerified            Boolean                 @default(false)
  pinCode               String?
  mustChangePassword    Boolean                 @default(false)
  pinAttempts           Int                     @default(0)
  passwordAttempts      Int                     @default(0)
  lockedUntil           DateTime?
  lastPinChange         DateTime?
  lastPasswordChange    DateTime?
  isArchived            Boolean                 @default(false)
  archivedAt            DateTime?
  archivedReason        String?
  archivedBy            String?
  autoArchived          Boolean                 @default(false)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  walletId              String?                 @unique
  accessCount           Int                     @default(0)
  activationRequestedAt DateTime?
  archiveScheduledAt    DateTime?
  isActiveForModule     Boolean                 @default(true)
  lastAccessedAt        DateTime?
  autoArchiveAt         DateTime?
  dischargeNotes        String?
  dischargeType         String?
  dischargedAt          DateTime?
  dischargedBy          String?
  fileStatus            String                  @default("ACTIVE")
  isDischarged          Boolean                 @default(false)
  tenantId              String
  deleteReason          String?
  deletedAt             DateTime?
  deletedBy             String?
  Admission             Admission[]
  Appointment           Appointment[]
  BillingRecord         BillingRecord[]
  ClinicalNote          ClinicalNote[]
  ImagingOrder          ImagingOrder[]
  KioskSession          KioskSession[]
  LabOrder              LabOrder[]
  MedicationTransaction MedicationTransaction[]
  NHISAuthorization     NHISAuthorization[]
  NHISClaim             NHISClaim[]
  Hospital              Hospital                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  PatientHistoryRecord  PatientHistoryRecord[]
  PatientJourney        PatientJourney[]
  PatientMessage        PatientMessage[]
  PatientQueue          PatientQueue[]
  PatientTransfer       PatientTransfer[]
  PatientWallet         PatientWallet?
  PaymentPlan           PaymentPlan[]
  Pregnancy             Pregnancy[]
  Prescription          Prescription[]
  VitalSign             VitalSign[]
  dental_records        dental_records[]
  immunizations         immunizations[]
  optometry_records     optometry_records[]
  patient_notifications patient_notifications[]

  @@unique([tenantId, hospitalId])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, isArchived])
  @@index([tenantId, fileStatus])
  @@index([tenantId, isDischarged])
  @@index([deletedAt])
}

model PatientHistoryRecord {
  id            String   @id @default(cuid())
  patientId     String
  encounterDate DateTime @default(now())
  doctorName    String
  encounterType String
  diagnosis     String
  icd10Code     String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenantId      String
  Patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  Hospital      Hospital @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model PatientJourney {
  id                      String         @id @default(cuid())
  patientId               String
  destinationType         String         @default("CLINIC")
  clinicId                String?
  wardId                  String?
  registeredById          String
  status                  String         @default("REGISTERED")
  cardGeneratedAt         DateTime?
