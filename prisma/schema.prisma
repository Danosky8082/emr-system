  leave_requests    leave_requests? @relation(fields: [leave_request_id], references: [id], onDelete: Cascade)
  Staff             Staff?          @relation(fields: [staff_id], references: [id], onDelete: Cascade)
  Hospital          Hospital        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model leave_policies {
  id                     String   @id @default(cuid())
  name                   String
  description            String?
  default_annual_days    Float    @default(21)
  default_sick_days      Float    @default(10)
  default_study_days     Float    @default(5)
  default_maternity_days Float    @default(90)
  default_paternity_days Float    @default(14)
  max_carry_over_days    Float    @default(5)
  carry_over_expiry      Int?
  leave_year_start_month Int      @default(1)
  leave_year_end_month   Int      @default(12)
  pro_rata_enabled       Boolean  @default(true)
  reminder_days          Int      @default(30)
  is_active              Boolean  @default(true)
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt
  tenantId               String
  Hospital               Hospital @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}

model leave_requests {
  id                                         String                @id @default(cuid())
  staff_id                                   String
  leave_type                                 String
  start_date                                 DateTime
  end_date                                   DateTime
  days                                       Int
  reason                                     String?
  contact_during_leave                       String?
  substitute_id                              String?
  status                                     String                @default("Pending")
  approved_by_id                             String?
  approved_at                                DateTime?
  comments                                   String?
  created_at                                 DateTime              @default(now())
  updated_at                                 DateTime              @updatedAt
  leave_usage_id                             String?               @unique
  tenantId                                   String
  leave_notifications                        leave_notifications[]
  Staff_leave_requests_approved_by_idToStaff Staff?                @relation("leave_requests_approved_by_idToStaff", fields: [approved_by_id], references: [id])
  Staff_leave_requests_staff_idToStaff       Staff                 @relation("leave_requests_staff_idToStaff", fields: [staff_id], references: [id])
  Staff_leave_requests_substitute_idToStaff  Staff?                @relation("leave_requests_substitute_idToStaff", fields: [substitute_id], references: [id])
  Hospital                                   Hospital              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leave_usages                               leave_usages?

  @@index([tenantId])
}

model leave_usages {
  id                                       String                    @id @default(cuid())
  staff_id                                 String
  leave_request_id                         String?                   @unique
  entitlement_id                           String?
  leave_type                               String
  days_used                                Float
  start_date                               DateTime
  end_date                                 DateTime
  status                                   String                    @default("PENDING")
  approved_by_id                           String?
  approved_at                              DateTime?
  notes                                    String?
  created_at                               DateTime                  @default(now())
  updated_at                               DateTime                  @updatedAt
  tenantId                                 String
  Staff_leave_usages_approved_by_idToStaff Staff?                    @relation("leave_usages_approved_by_idToStaff", fields: [approved_by_id], references: [id])
  staff_leave_entitlements                 staff_leave_entitlements? @relation(fields: [entitlement_id], references: [id])
  leave_requests                           leave_requests?           @relation(fields: [leave_request_id], references: [id])
  Staff_leave_usages_staff_idToStaff       Staff                     @relation("leave_usages_staff_idToStaff", fields: [staff_id], references: [id])
  Hospital                                 Hospital                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model optometry_records {
  id                       String   @id @default(cuid())
  patientId                String
  examinationDate          DateTime @default(now())
  visualAcuityRight        String?
  visualAcuityLeft         String?
  intraocularPressureRight Float?
  intraocularPressureLeft  Float?
  refractionRight          String?
  refractionLeft           String?
  diagnosis                String?
  treatment                String?
  prescription             String?
  notes                    String?
  staffId                  String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  tenantId                 String
  Patient                  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  Staff                    Staff    @relation(fields: [staffId], references: [id])
  Hospital                 Hospital @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model patient_notifications {
  id        String   @id @default(cuid())
  patientId String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  tenantId  String
  Patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  Hospital  Hospital @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model performance_reviews {
  id                                           String    @id @default(cuid())
  staff_id                                     String
  reviewer_id                                  String
  review_date                                  DateTime
  period_start                                 DateTime?
  period_end                                   DateTime?
  rating                                       Int?
  strengths                                    String?
  weaknesses                                   String?
  goals                                        String?
  recommendations                              String?
  overall_comments                             String?
  created_at                                   DateTime  @default(now())
  updated_at                                   DateTime  @updatedAt
  tenantId                                     String
  Staff_performance_reviews_reviewer_idToStaff Staff     @relation("performance_reviews_reviewer_idToStaff", fields: [reviewer_id], references: [id])
  Staff_performance_reviews_staff_idToStaff    Staff     @relation("performance_reviews_staff_idToStaff", fields: [staff_id], references: [id])
  Hospital                                     Hospital  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model staff_leave_entitlements {
  id                       String         @id @default(cuid())
  staff_id                 String
  year                     Int
  annual_leave_days        Float          @default(21)
  sick_leave_days          Float          @default(10)
  study_leave_days         Float          @default(5)
  maternity_leave_days     Float          @default(90)
  paternity_leave_days     Float          @default(14)
  unpaid_leave_days        Float          @default(0)
  carried_over_days        Float          @default(0)
  total_available_days     Float
  used_annual_days         Float          @default(0)
  used_sick_days           Float          @default(0)
  used_study_days          Float          @default(0)
  used_maternity_days      Float          @default(0)
  used_paternity_days      Float          @default(0)
  used_unpaid_days         Float          @default(0)
  remaining_annual_days    Float
  remaining_sick_days      Float
  remaining_study_days     Float
  remaining_maternity_days Float
  remaining_paternity_days Float
  remaining_unpaid_days    Float
  is_active                Boolean        @default(true)
  is_locked                Boolean        @default(false)
  created_by               String?
  updated_by               String?
  notes                    String?
  created_at               DateTime       @default(now())
  updated_at               DateTime       @updatedAt
  tenantId                 String
  leave_usages             leave_usages[]
  Staff                    Staff          @relation(fields: [staff_id], references: [id])
  Hospital                 Hospital       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, staff_id, year])
  @@index([tenantId])
}

model staff_trainings {
  staff_id           String
  training_id        String
  enrollment_date    DateTime  @default(now())
  completion_date    DateTime?
  completion_status  String    @default("Enrolled")
  certificate_issued Boolean   @default(false)
  score              Int?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  tenantId           String
  Staff              Staff     @relation(fields: [staff_id], references: [id])
  Hospital           Hospital  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trainings          trainings @relation(fields: [training_id], references: [id])

  @@id([tenantId, staff_id, training_id])
  @@index([tenantId])
}

model trainings {
  id                   String            @id @default(cuid())
  title                String
  description          String?
  provider             String?
  start_date           DateTime
  end_date             DateTime?
  cost                 Float?
  location             String?
  max_participants     Int?
  certificate_provided Boolean           @default(false)
  created_at           DateTime          @default(now())
  updated_at           DateTime          @updatedAt
  tenantId             String
  staff_trainings      staff_trainings[]
  Hospital             Hospital          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}
