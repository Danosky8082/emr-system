  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("leave_notifications")
}

// 45a. Staff Leave Entitlement
model StaffLeaveEntitlement {
  id                  String   @id @default(cuid())
  staffId             String   @map("staff_id")
  staff               Staff    @relation(fields: [staffId], references: [id])
  
  year                Int      @map("year")
  annualLeaveDays     Float    @default(21) @map("annual_leave_days")
  sickLeaveDays       Float    @default(10) @map("sick_leave_days")
  studyLeaveDays      Float    @default(5)  @map("study_leave_days")
  maternityLeaveDays  Float    @default(90) @map("maternity_leave_days")
  paternityLeaveDays  Float    @default(14) @map("paternity_leave_days")
  unpaidLeaveDays     Float    @default(0)  @map("unpaid_leave_days")
  
  carriedOverDays     Float    @default(0)  @map("carried_over_days")
  totalAvailableDays  Float    @map("total_available_days")
  
  usedAnnualDays      Float    @default(0)  @map("used_annual_days")
  usedSickDays        Float    @default(0)  @map("used_sick_days")
  usedStudyDays       Float    @default(0)  @map("used_study_days")
  usedMaternityDays   Float    @default(0)  @map("used_maternity_days")
  usedPaternityDays   Float    @default(0)  @map("used_paternity_days")
  usedUnpaidDays      Float    @default(0)  @map("used_unpaid_days")
  
  remainingAnnualDays Float    @map("remaining_annual_days")
  remainingSickDays   Float    @map("remaining_sick_days")
  remainingStudyDays  Float    @map("remaining_study_days")
  remainingMaternityDays Float @map("remaining_maternity_days")
  remainingPaternityDays Float @map("remaining_paternity_days")
  remainingUnpaidDays Float    @map("remaining_unpaid_days")
  
  isActive            Boolean  @default(true) @map("is_active")
  isLocked            Boolean  @default(false) @map("is_locked")
  
  createdBy           String?  @map("created_by")
  updatedBy           String?  @map("updated_by")
  notes               String?  @db.Text
  
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  
  leaveUsages         LeaveUsage[]
  
  @@unique([staffId, year])
  @@map("staff_leave_entitlements")
}

// 45b. Leave Usage Tracking - FIXED
model LeaveUsage {
  id                  String   @id @default(cuid())
  staffId             String   @map("staff_id")
  staff               Staff    @relation("LeaveUsageStaff", fields: [staffId], references: [id])
  
  // ✅ FIXED: LEAVE REQUEST RELATION - This side defines the relation
  leaveRequestId      String?  @unique @map("leave_request_id")
  leaveRequest        LeaveRequest? @relation(fields: [leaveRequestId], references: [id])
  
  entitlementId       String?  @map("entitlement_id")
  entitlement         StaffLeaveEntitlement? @relation(fields: [entitlementId], references: [id])
  
  leaveType           String   @map("leave_type")
  daysUsed            Float    @map("days_used")
  
  startDate           DateTime @map("start_date")
  endDate             DateTime @map("end_date")
  
  status              String   @default("PENDING")
  
  approvedById        String?  @map("approved_by_id")
  approvedBy          Staff?   @relation("LeaveUsageApprover", fields: [approvedById], references: [id])
  approvedAt          DateTime? @map("approved_at")
  notes               String?  @db.Text
  
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  
  @@map("leave_usages")
}

// 45c. Leave Policy Configuration
model LeavePolicy {
  id                  String   @id @default(cuid())
  name                String   @unique
  description         String?  @db.Text
  
  defaultAnnualDays   Float    @default(21) @map("default_annual_days")
  defaultSickDays     Float    @default(10) @map("default_sick_days")
  defaultStudyDays    Float    @default(5)  @map("default_study_days")
  defaultMaternityDays Float   @default(90) @map("default_maternity_days")
  defaultPaternityDays Float   @default(14) @map("default_paternity_days")
  
  maxCarryOverDays    Float    @default(5)  @map("max_carry_over_days")
  carryOverExpiry     Int?     @map("carry_over_expiry")
  
  leaveYearStartMonth Int      @default(1)  @map("leave_year_start_month")
  leaveYearEndMonth   Int      @default(12) @map("leave_year_end_month")
  
  proRataEnabled      Boolean  @default(true) @map("pro_rata_enabled")
  reminderDays        Int      @default(30) @map("reminder_days")
  
  isActive            Boolean  @default(true) @map("is_active")
  
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  
  @@map("leave_policies")
}

