// 33. Radiology/Imaging Orders
model ImagingOrder {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  patientId       String
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  
