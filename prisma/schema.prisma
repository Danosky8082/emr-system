// 35. Patient Transfer/Referral
model PatientTransfer {
  id                String   @id @default(cuid())
  transferNumber    String   @unique
  
  patientId         String
  patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  
  fromLocationType  String
  fromClinicId      String?
  fromClinic        Clinic?  @relation("FromClinicTransfer", fields: [fromClinicId], references: [id])
  fromWardId        String?
  fromWard          Ward?    @relation("FromWardTransfer", fields: [fromWardId], references: [id])
  
  toLocationType    String
  toClinicId        String?
  toClinic          Clinic?  @relation("ToClinicTransfer", fields: [toClinicId], references: [id])
  toWardId          String?
  toWard            Ward?    @relation("ToWardTransfer", fields: [toWardId], references: [id])
  
  reason            String   @db.Text
  priority          String   @default("Normal")
  transportType     String?
  
  requestedBy       String
  requestedStaff    Staff    @relation("RequestedByStaff", fields: [requestedBy], references: [id])
  approvedBy        String?
  approvedStaff     Staff?   @relation("ApprovedByStaff", fields: [approvedBy], references: [id])
  
