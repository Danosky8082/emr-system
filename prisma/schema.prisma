  location    String?
  costCenter  String?
  isActive    Boolean  @default(true)
  staff       Staff[]  @relation("StaffDepartment")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

